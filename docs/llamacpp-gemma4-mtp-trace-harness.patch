+    switch (type) {
+        case GGML_TYPE_F32:  return *(const float *) &data[off];
+        case GGML_TYPE_F16:  return ggml_fp16_to_fp32(*(const ggml_fp16_t *) &data[off]);
+        case GGML_TYPE_BF16: return ggml_bf16_to_fp32(*(const ggml_bf16_t *) &data[off]);
+        default: return 0.0f;
+    }
